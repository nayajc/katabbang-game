rules_version = '2';

// Leaderboard is create-only from the client: entries can never be edited or
// deleted by players. Moderation happens by manual deletion in the Firebase
// console (see .omc/handoffs/track-c2.md).
service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{scoreId} {
      // TOP 100 is public.
      allow read: if true;

      allow create: if request.auth != null
        && isValidScore(request.resource.data)
        && request.resource.data.uid == request.auth.uid;

      // No mutation of an existing record, ever.
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidScore(data) {
      return data.keys().hasOnly(['nickname', 'score', 'distance', 'combo', 'createdAt', 'uid'])
        && data.keys().hasAll(['nickname', 'score', 'distance', 'combo', 'createdAt', 'uid'])
        && data.nickname is string
        && data.nickname.matches('^[가-힣a-zA-Z0-9]{2,12}$')
        && data.score is int && data.score >= 0 && data.score <= 10000000
        && data.distance is int && data.distance >= 0 && data.distance <= 10000000
        && data.combo is int && data.combo >= 0 && data.combo <= 10000000
        && data.uid is string
        && data.createdAt == request.time;
    }
  }
}
